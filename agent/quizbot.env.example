# Copy to quizbot.env (same folder as agent.py) and edit.
# Changes apply on the next capture — no restart needed.
QUIZBOT_SERVER=http://10.1.1.99:11138
QUIZBOT_TOKEN=change-me

# Leave empty to use what's set on the dashboard (Settings): one place for every machine.
# Set a value here only to override it for this machine.
QUIZBOT_SESSION=
QUIZBOT_MODEL=

# QUIZBOT_MACHINE=work-laptop        # default: hostname
QUIZBOT_NOTIFY=1
# Coding problems: put the solution on the clipboard (paste into the editor with Ctrl+V)
QUIZBOT_COPY_CODE=1

# Capture hotkey: modifiers + ` (ctrl, shift, alt, cmd). Restart the agent after changing.
# QUIZBOT_HOTKEY=ctrl+`
