# Copy to quizbot.env (same folder as agent.py) and edit.
QUIZBOT_SERVER=http://192.168.1.10:8765
QUIZBOT_TOKEN=change-me
# QUIZBOT_SESSION=physics-quiz-1     # default: today's date
# QUIZBOT_MACHINE=work-laptop        # default: hostname
QUIZBOT_NOTIFY=1
# Model for captures from this machine (empty = server default). Use to compare speed live:
# QUIZBOT_MODEL=claude-haiku-5-5
