# Copy to .env and fill in.

# Prebuilt image from GitHub Actions (leave unset to build locally).
# QUIZBOT_IMAGE=ghcr.io/<your-github-user>/quizbot:latest

ANTHROPIC_API_KEY=sk-ant-...

# Shared secret every agent / iPhone Shortcut must send. Leave empty to disable (not recommended).
QUIZBOT_TOKEN=change-me

# claude-sonnet-5-5 = best accuracy/speed balance; claude-haiku-5-5 = fastest; claude-opus-5-5 = hardest questions.
QUIZBOT_MODEL=claude-sonnet-5-5

# "claude" (default) or "fake" to test the pipeline without spending tokens.
QUIZBOT_SOLVER=claude

# Longest image edge sent to the model.
QUIZBOT_MAX_EDGE=1568
